{
  "name": "@umbraco-cms/mcp-skills",
  "version": "1.0.0-beta.39",
  "private": true,
  "type": "module",
  "description": "Skills and agents for building Umbraco MCP servers",
  "scripts": {
    "test": "node --experimental-vm-modules $(npm root)/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand --passWithNoTests",
    "test:evals": "node --experimental-vm-modules $(npm root)/jest/bin/jest.js --testPathPatterns=__evals__ --runInBand --testTimeout=120000 --forceExit",
    "test:evals:verbose": "E2E_VERBOSITY=verbose node --experimental-vm-modules $(npm root)/jest/bin/jest.js --testPathPatterns=__evals__ --runInBand --testTimeout=120000 --forceExit",
    "test:all": "node --experimental-vm-modules $(npm root)/jest/bin/jest.js --runInBand --testTimeout=120000 --forceExit"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.191",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.3"
  }
}
