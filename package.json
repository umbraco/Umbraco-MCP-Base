{
  "name": "umbraco-mcp-server-sdk-monorepo",
  "version": "17.0.0-beta.28",
  "private": true,
  "description": "Umbraco MCP Server SDK monorepo",
  "workspaces": [
    "packages/*",
    "template",
    "plugins/umbraco-mcp-skills",
    "tests/cli"
  ],
  "scripts": {
    "build": "npm run build -w packages/mcp-server-sdk",
    "build:create": "npm run build -w packages/create-mcp-server",
    "build:hosted": "npm run build -w packages/hosted-mcp",
    "build:all": "npm run build && npm run build:hosted && npm run build:create",
    "clean": "npm run clean -w packages/mcp-server-sdk",
    "compile": "npm run compile -w packages/mcp-server-sdk",
    "test": "npm run test -w packages/mcp-server-sdk",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/hosted-mcp-e2e/integration/jest.config.ts --runInBand --forceExit",
    "test:integration:chained": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/hosted-chained-mcp-e2e/integration/jest.config.ts --runInBand --forceExit",
    "test:e2e": "npx playwright test --config tests/hosted-mcp-e2e/e2e/playwright.config.ts",
    "test:e2e:chained": "npx playwright test --config tests/hosted-chained-mcp-e2e/e2e/playwright.config.ts",
    "test:e2e:cloud": "node --env-file-if-exists=.env.test.cloud ./node_modules/@playwright/test/cli.js test --config tests/hosted-mcp-e2e/e2e/playwright.config.ts cloud-mcp-inspector.test.ts",
    "test:template": "USE_MOCK_API=true node --experimental-vm-modules node_modules/jest/bin/jest.js --config template/jest.config.ts --testPathPattern=__tests__ --runInBand",
    "test:cli": "cd tests/cli && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config integration/jest.config.ts --runInBand --forceExit",
    "test:cli:evals": "cd tests/cli && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config evals/jest.config.ts --runInBand --forceExit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umbraco/Umbraco-MCP-Base.git"
  },
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "Phil Whittaker",
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1"
  }
}
