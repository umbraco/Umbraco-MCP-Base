# Cloud E2E test environment variables.
#
# Copy this file to `.env.test.cloud` (gitignored) and fill in the values
# for your sandbox Umbraco Cloud project, then run:
#
#   npm run test:e2e:cloud
#
# Required:

# Cloud project alias (without the .{region}.umbraco.io suffix)
UMBRACO_CLOUD_TEST_PROJECT=hosted-mcp-worker-test

# Backoffice user with access to the project (Cloud SSO email)
UMBRACO_CLOUD_TEST_USER=you@example.com
UMBRACO_CLOUD_TEST_PASSWORD=replace-me

# OAuth client_id registered in the project (matches McpOAuthComposer.cs)
UMBRACO_CLOUD_OAUTH_CLIENT_ID=umbraco-mcp-cms-hosted

# Optional — defaults to "euwest01"
# UMBRACO_CLOUD_REGION=euwest01
