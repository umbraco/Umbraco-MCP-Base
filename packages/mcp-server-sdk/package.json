{
  "name": "@umbraco-cms/mcp-server-sdk",
  "version": "17.0.0-beta.19",
  "type": "module",
  "description": "Umbraco-specific MCP infrastructure and patterns for building MCP servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "umbraco-mcp-generate-types": "./dist/cli/generate-tool-types.js",
    "umbraco-mcp-widgets": "./dist/cli/widgets-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "import": "./dist/evals/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./widget-runtime": {
      "types": "./dist/widget-runtime/index.d.ts",
      "import": "./dist/widget-runtime/index.js"
    },
    "./widget-build": {
      "types": "./dist/widget-build/index.d.ts",
      "import": "./dist/widget-build/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:widgets": "tsx scripts/build-builtin-widgets.ts",
    "build": "npm run build:widgets && tsup",
    "compile": "npm run build:widgets && tsc --noEmit",
    "watch": "tsup --watch",
    "pretest": "npm run build:widgets",
    "test": "npm run test:parallel && npm run test:stdio",
    "test:parallel": "NODE_OPTIONS='--experimental-vm-modules' jest --testPathIgnorePatterns='src/mcp-client/__tests__/(manager|proxy).test.ts'",
    "test:stdio": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='src/mcp-client/__tests__/(manager|proxy).test.ts'",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umbraco/Umbraco-MCP-Base.git"
  },
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol",
    "sdk"
  ],
  "author": "Umbraco HQ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/umbraco/Umbraco-MCP-Base/issues"
  },
  "homepage": "https://github.com/umbraco/Umbraco-MCP-Base#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "json-schema-to-typescript": "^15.0.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.39",
    "@jest/types": "^29.6.3",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.11",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2.39",
    "@modelcontextprotocol/ext-apps": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    }
  }
}
