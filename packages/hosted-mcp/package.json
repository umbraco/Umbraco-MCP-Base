{
  "name": "@umbraco-cms/mcp-hosted",
  "version": "17.0.0-beta.16",
  "description": "Hosted MCP server infrastructure for Umbraco on Cloudflare Workers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs');fs.copyFileSync('agents-mcp.d.ts','dist/agents-mcp.d.ts');const d=fs.readFileSync('dist/index.d.ts','utf8');fs.writeFileSync('dist/index.d.ts','/// <reference path=\\\"agents-mcp.d.ts\\\" />\\n'+d)\"",
    "compile": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:integration": "npm run test:integration --prefix ../..",
    "test:e2e": "npm run test:e2e --prefix ../..",
    "prepack": "node ../../scripts/rewrite-file-deps.mjs",
    "postpack": "node ../../scripts/restore-package-json.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@umbraco-cms/mcp-server-sdk": "file:../mcp-server-sdk",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "agents-mcp.d.ts"
  ],
  "license": "MIT"
}
